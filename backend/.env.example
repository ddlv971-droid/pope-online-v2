# Render will inject PORT automatically
NODE_ENV=production

# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
JWT_SECRET=change_me
CORS_ORIGIN=https://YOUR_NETLIFY_SITE.netlify.app
FRONTEND_BASE_URL=https://pope-online.com
FRONTEND_CANONICAL_URL=

# Mistral
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-small-latest

# Email provider (Resend recommended)
MAIL_PROVIDER=resend
MAIL_API_KEY=...
MAIL_FROM=contact@pope-online.com
MAIL_TO=contact@pope-online.com

SESSION_COOKIE_SAMESITE=None

SESSION_COOKIE_MAX_AGE_SECONDS=43200
JWT_EXPIRES_IN=12h
TURNSTILE_SECRET_KEY=
