NODE_ENV=production

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
JWT_SECRET=CHANGEZ_MOI_MINIMUM_64_CHARS_ALEATOIRES

# ── URLs ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://popeonline-staging.netlify.app
FRONTEND_BASE_URL=https://popeonline-staging.netlify.app
FRONTEND_CANONICAL_URL=

# ── IA ────────────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL
MISTRAL_MODEL=mistral-small-latest

# ── MAIL ──────────────────────────────────────────────────────────────────────
# ATTENTION : MAIL_FROM doit être sur un domaine VÉRIFIÉ dans Resend.
#
# Si pope-online.com est vérifié dans Resend → utiliser no-reply@pope-online.com
# Sinon pour staging (aucune config DNS requise) → utiliser onboarding@resend.dev
#
MAIL_PROVIDER=resend
MAIL_API_KEY=VOTRE_CLE_RESEND
MAIL_FROM=onboarding@resend.dev
MAIL_TO=contact@pope-online.com

# ── Sécurité ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_MAX_AGE_SECONDS=43200
JWT_EXPIRES_IN=12h
TURNSTILE_SECRET_KEY=

# ── Admin ─────────────────────────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=ddlv971@gmail.com
DEFAULT_ADMIN_USERNAME=Denis DELVER
DEFAULT_ADMIN_PASSWORD=
