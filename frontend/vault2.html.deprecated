<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>POPE Online — Dépôt sécurisé 48h</title>
<link rel="icon" href="./assets/favicon.png" type="image/png"/>
<link rel="stylesheet" href="pope2.css"/>
</head>
<body>

<header class="p2-topbar">
  <div style="display:flex;align-items:center;gap:12px;width:100%;max-width:1280px;margin:0 auto;padding:0 20px">
    <a class="p2-topbar-brand" href="dashboard2.html" id="p2VaultHome">
      <img src="./assets/popeonline-logo.png" alt="POPE Online"/>
      <span class="p2-topbar-brand-name">POPE Online</span>
    </a>
    <div class="p2-topbar-sep"></div>
    <span class="p2-topbar-label" id="p2VaultSpaceLabel">Dépôt sécurisé</span>
    <nav class="p2-topbar-nav">
      <a class="p2-topbar-btn" href="dashboard2.html" id="p2VaultReturnBtn">← Retour</a>
      <button class="p2-topbar-btn" data-logout>Déconnexion</button>
    </nav>
    <button class="p2-burger" id="p2Burger" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</header>
<div class="p2-mobile-menu" id="p2MobileMenu">
  <a href="dashboard2.html" id="p2VaultReturnMob">← Retour</a>
  <div class="p2-mobile-sep"></div>
  <button data-logout>🚪 Déconnexion</button>
</div>

<main class="p2-main">

  <!-- Hero vault -->
  <div class="p2-hero" style="margin-bottom:20px">
    <div class="p2-hero-text">
      <div class="p2-hero-eyebrow">📂 Dépôt sécurisé</div>
      <h1 class="p2-hero-title">Vos documents 48h</h1>
      <p class="p2-hero-sub">Déposez vos pièces (contrats, rapports, délibérations…) pour les joindre à vos demandes expertes. Fichiers conservés 48h, supprimés automatiquement.</p>
    </div>
  </div>

  <!-- Infos -->
  <div style="display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap">
    <div style="background:var(--white);border:1.5px solid var(--border);border-radius:10px;padding:12px 16px;flex:1;min-width:140px">
      <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">Durée de conservation</div>
      <div style="font-size:16px;font-weight:800;color:var(--ink)">48 heures</div>
    </div>
    <div style="background:var(--white);border:1.5px solid var(--border);border-radius:10px;padding:12px 16px;flex:1;min-width:140px">
      <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">Taille max par fichier</div>
      <div style="font-size:16px;font-weight:800;color:var(--ink)">25 Mo</div>
    </div>
    <div style="background:var(--white);border:1.5px solid var(--border);border-radius:10px;padding:12px 16px;flex:1;min-width:140px">
      <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">Formats acceptés</div>
      <div style="font-size:14px;font-weight:700;color:var(--ink)">PDF, Word, Excel…</div>
    </div>
  </div>

  <!-- Zone de dépôt -->
  <div class="p2-card">
    <div class="p2-card-head">
      <h2>Déposer un document</h2>
      <p>Glissez-déposez un fichier ou cliquez pour parcourir.</p>
    </div>
    <div class="p2-card-body">
      <div class="p2-vault-zone" id="p2DropZone">
        <div class="p2-vault-zone-ico">📂</div>
        <strong>Glisser-déposer ici</strong>
        <p>ou cliquez pour sélectionner un fichier</p>
        <input type="file" id="p2FileInput" style="display:none" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.odt,.ods,.odp,.png,.jpg,.jpeg"/>
      </div>
      <div class="p2-progress" id="p2UploadProgress" style="display:none;margin-top:8px">
        <div class="p2-progress-bar" id="p2UploadBar" style="width:0%"></div>
      </div>
      <div class="p2-msg" id="p2UploadMsg"></div>
    </div>
  </div>

  <!-- Liste des fichiers -->
  <div class="p2-card">
    <div class="p2-card-head" style="display:flex;align-items:center;justify-content:space-between">
      <div><h2>Mes pièces déposées</h2><p>Fichiers disponibles pour vos demandes expertes.</p></div>
      <button class="p2-btn p2-btn-ghost p2-btn-sm" onclick="refreshList()">🔄 Actualiser</button>
    </div>
    <div class="p2-card-body">
      <div id="p2VaultList">
        <div class="p2-empty"><div class="p2-empty-ico">📂</div><strong>Chargement…</strong></div>
      </div>
    </div>
  </div>

  <!-- Conseil -->
  <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;padding:14px 16px;font-size:12px;color:#0369a1;margin-top:4px">
    💡 <strong>Bon à savoir :</strong> Vos fichiers sont supprimés automatiquement après 48h. Pour les retrouver dans vos demandes, déposez-les juste avant de soumettre votre besoin à un expert.
  </div>

</main>

<script src="pope2.js"></script>
<script>
// Détecter l'espace depuis l'URL
const _vaultSp = new URLSearchParams(location.search).get('space') === 'private' ? 'private' : 'public';

// Mettre à jour les liens de retour
const retBtn = document.getElementById('p2VaultReturnBtn');
const retMob = document.getElementById('p2VaultReturnMob');
const retParam = new URLSearchParams(location.search).get('return') || (_vaultSp === 'private' ? 'dashboard2-private.html' : 'dashboard2.html');
if (retBtn) retBtn.href = retParam;
if (retMob) retMob.href = retParam;
const homeLink = document.getElementById('p2VaultHome');
if (homeLink) homeLink.href = retParam;

// Label espace
const spLabel = document.getElementById('p2VaultSpaceLabel');
if (spLabel) spLabel.textContent = _vaultSp === 'private' ? '🔒 Dépôt privé 48h' : '📂 Dépôt public 48h';

function refreshList() {
  if (window._vaultRefresh) window._vaultRefresh(_vaultSp);
}

// Stocker la référence de refresh
window._vaultRefresh = null;

// Init via P2
P2.initVault(_vaultSp).then(() => {
  // Surcharger refreshList
  window._vaultRefresh = (sp) => {
    P2.api('/vault/?space=' + sp)
      .then(data => {
        const files = data.files || data.items || data || [];
        const list = document.getElementById('p2VaultList');
        if (!list) return;
        if (!files.length) {
          list.innerHTML = '<div class="p2-empty"><div class="p2-empty-ico">📂</div><strong>Aucune pièce déposée.</strong><p>Glissez-déposez vos documents pour commencer.</p></div>';
          return;
        }
        const tok = sessionStorage.getItem('pope_session_token') || localStorage.getItem('pope_session_token') || '';
        const API = (window.__POPE_API_BASE__ || 'https://pope-online-v2.onrender.com').replace(/\/$/, '');
        list.innerHTML = '<div class="p2-file-list">' + files.map(f => {
          const exp = f.expires_at ? new Date(f.expires_at) : null;
          const hrs = exp ? Math.max(0, Math.ceil((exp.getTime() - Date.now()) / 3600000)) : null;
          const badge = hrs != null ? `<span class="p2-expiry-badge ${hrs < 6 ? 'urgent' : ''}">${hrs}h restante${hrs > 1 ? 's' : ''}</span>` : '';
          return `<div class="p2-file" data-file-id="${f.id}">
            <div class="p2-file-ico">📄</div>
            <div style="flex:1;min-width:0">
              <div class="p2-file-name">${String(f.original_name||f.filename||'Fichier').replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div>
              <div class="p2-file-meta">${f.size_kb ? f.size_kb + ' Ko · ' : ''}${badge}</div>
            </div>
            <a href="${API}/vault/${f.id}/download?token=${tok}" target="_blank" class="p2-btn p2-btn-ghost p2-btn-sm" style="margin-right:4px">⬇️ Télécharger</a>
            <button class="p2-file-del" data-del="${f.id}" title="Supprimer">🗑</button>
          </div>`;
        }).join('') + '</div>';

        list.querySelectorAll('[data-del]').forEach(btn => {
          btn.addEventListener('click', async () => {
            if (!confirm('Supprimer ce fichier définitivement ?')) return;
            try { await P2.api('/vault/' + btn.dataset.del, { method: 'DELETE' }); window._vaultRefresh(sp); }
            catch { alert('Erreur lors de la suppression.'); }
          });
        });
      })
      .catch(() => {
        const list = document.getElementById('p2VaultList');
        if (list) list.innerHTML = '<div class="p2-empty"><div class="p2-empty-ico">⚠️</div><strong>Impossible de charger les fichiers.</strong></div>';
      });
  };
  window._vaultRefresh(_vaultSp);
});
</script>
</body>
</html>
